<!doctype html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="../assets/css/pico.min.css">
    <link rel="stylesheet" href="../assets/css/custom.css">
    <link rel="stylesheet" href="../assets/css/dashboard.css">
    <link rel="stylesheet" href="../assets/css/bootstrap-icons.css">
    <link rel="stylesheet" href="../assets/css/guide.css">
    <title>D2RBot Dashboard</title>
       
</head>
<body>
<main class="container-fluid">
    <div id="loading" class="loading"></div>
    <div id="dashboard" style="display: none;">
        <!-- Header with Logo and Title -->
        <div class="dashboard-header">
            <div class="dashboard-title-container">
                <div class="logo-container">
                    <img src="../assets/d2rbot-logo.png" alt="D2RBot" class="dashboard-logo">
                </div>
                <h1 class="dashboard-title">D2RBot</h1>
                <span id="version" class="version-badge"></span>
            </div>
        </div>
        
        <!-- Tabbed Navigation -->
        <div class="tab-navigation">
            <div class="tab-buttons">
                <button class="tab-btn active" data-tab="dashboard">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                </button>
                <button class="tab-btn" data-tab="characters">
                    <i class="bi bi-people"></i>
                    <span>Characters</span>
                </button>
                <button class="tab-btn" data-tab="settings">
                    <i class="bi bi-gear"></i>
                    <span>Settings</span>
                </button>
                <button class="tab-btn" data-tab="guide">
                    <i class="bi bi-book"></i>
                    <span>Guide</span>
                </button>
                <button class="tab-btn" data-tab="logs">
                    <i class="bi bi-journal-text"></i>
                    <span>Logs</span>
                </button>
            </div>
        </div>
        
        <!-- Tab Content -->
        <div class="tab-content">
            <!-- Dashboard Tab -->
            <div class="tab-pane active" id="dashboard-tab">
                <div class="dashboard-controls">
                    <button id="reloadConfigBtn" class="btn btn-outline" onclick="reloadConfig()">
                        <i class="bi bi-arrow-clockwise btn-icon"></i>Reload Configs
                    </button>
                    <button class="btn btn-primary" onclick="location.href='/supervisorSettings'">
                        <i class="bi bi-plus btn-icon"></i>Add Character
                    </button>
                </div>
                <div id="characters-container"></div>
            </div>
            
            <!-- Characters Tab -->
            <div class="tab-pane" id="characters-tab">
                <div class="characters-grid">
                    <div class="character-summary-cards" id="character-summary"></div>
                </div>
                <style>
                .character-summary-card {
                    background: var(--card-background-color);
                    border: 1px solid var(--border-color);
                    border-radius: 12px;
                    padding: 20px;
                    margin-bottom: 15px;
                }
                .summary-header {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    margin-bottom: 15px;
                }
                .summary-status {
                    width: 12px;
                    height: 12px;
                    border-radius: 50%;
                    background: #6c757d;
                }
                .summary-status.status-ingame { background: #28a745; }
                .summary-status.status-paused { background: #ffc107; }
                .summary-status.status-starting { background: #17a2b8; }
                .summary-stats {
                    display: grid;
                    grid-template-columns: 1fr 1fr;
                    gap: 10px;
                    margin-bottom: 15px;
                }
                .summary-stat {
                    display: flex;
                    justify-content: space-between;
                }
                </style>
            </div>
            
            <!-- Settings Tab -->
            <div class="tab-pane" id="settings-tab">
                <div class="settings-container">
                    <button class="btn btn-outline" onclick="location.href='/config'">
                        <i class="bi bi-gear btn-icon"></i>Global Settings
                    </button>
                </div>
            </div>
            
            <!-- Guide Tab -->
            <div class="tab-pane" id="guide-tab">
                <div class="guide-container">
                    <div class="guide-header">
                        <h2><i class="bi bi-book"></i> D2RBot Complete Guide</h2>
                        <div class="guide-progress">
                            <div class="progress-bar">
                                <div class="progress-fill" id="guide-progress"></div>
                            </div>
                            <span class="progress-text">Progress: <span id="progress-percent">0%</span></span>
                        </div>
                    </div>
                    
                    <div class="guide-navigation">
                        <div class="guide-sections">
                            <div class="section-card" data-section="getting-started">
                                <div class="section-icon">🚀</div>
                                <h3>Getting Started</h3>
                                <p>Installation and initial setup</p>
                                <div class="section-status"><i class="bi bi-circle"></i></div>
                            </div>
                            <div class="section-card" data-section="single-player">
                                <div class="section-icon">👤</div>
                                <h3>Single Player Setup</h3>
                                <p>Configure for offline play</p>
                                <div class="section-status"><i class="bi bi-circle"></i></div>
                            </div>
                            <div class="section-card" data-section="online-setup">
                                <div class="section-icon">🌐</div>
                                <h3>Online Setup</h3>
                                <p>Battle.net configuration</p>
                                <div class="section-status"><i class="bi bi-circle"></i></div>
                            </div>
                            <div class="section-card" data-section="character-setup">
                                <div class="section-icon">⚔️</div>
                                <h3>Character Setup</h3>
                                <p>Configure runs and settings</p>
                                <div class="section-status"><i class="bi bi-circle"></i></div>
                            </div>
                            <div class="section-card" data-section="pickit-guide">
                                <div class="section-icon">💎</div>
                                <h3>Pickit System</h3>
                                <p>Item filtering and pickup rules</p>
                                <div class="section-status"><i class="bi bi-circle"></i></div>
                            </div>
                            <div class="section-card" data-section="advanced-features">
                                <div class="section-icon">🔧</div>
                                <h3>Advanced Features</h3>
                                <p>Companion mode, scheduler, gambling</p>
                                <div class="section-status"><i class="bi bi-circle"></i></div>
                            </div>
                            <div class="section-card" data-section="troubleshooting">
                                <div class="section-icon">🔧</div>
                                <h3>Troubleshooting</h3>
                                <p>Common issues and solutions</p>
                                <div class="section-status"><i class="bi bi-circle"></i></div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="guide-content" id="guide-content">
                        <div class="welcome-screen">
                            <div class="welcome-icon">📚</div>
                            <h2>Welcome to the D2RBot Guide!</h2>
                            <p>Select a section from above to begin your journey. Complete each section to track your progress.</p>
                            <div class="quick-start">
                                <h3>Quick Start Checklist:</h3>
                                <ul class="checklist">
                                    <li><input type="checkbox" id="check-d2r"> <label for="check-d2r">Diablo II: Resurrected installed</label></li>
                                    <li><input type="checkbox" id="check-d2lod"> <label for="check-d2lod">Diablo II: LOD 1.13c installed</label></li>
                                    <li><input type="checkbox" id="check-resolution"> <label for="check-resolution">Game set to 1280x720 windowed</label></li>
                                    <li><input type="checkbox" id="check-english"> <label for="check-english">Game language set to English</label></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Logs Tab -->
            <div class="tab-pane" id="logs-tab">
                <div class="logs-container">
                    <div class="logs-controls">
                        <select id="log-file-selector" class="log-selector">
                            <option value="">Select a log file...</option>
                        </select>
                        <button id="refresh-logs-btn" class="btn btn-outline">
                            <i class="bi bi-arrow-clockwise"></i>
                            Refresh
                        </button>
                        <button id="auto-scroll-btn" class="btn btn-outline active" data-enabled="true">
                            <i class="bi bi-arrow-down"></i>
                            Auto Scroll
                        </button>
                    </div>
                    <div class="log-viewer">
                        <div id="log-content" class="log-content">
                            <div class="log-placeholder">
                                Select a log file from the dropdown above to view its contents.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
<script src="../assets/js/dashboard.js"></script>
<script src="../assets/js/guide.js"></script>
</body>
</html>